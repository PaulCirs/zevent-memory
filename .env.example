# Modèle du fichier .env (jamais versionné).
# En dev : copier ce fichier en .env à la racine du repo. Les valeurs ci-dessous suffisent.
# En prod : .env créé à la main sur le serveur, avec des mots de passe générés.

# Lues par compose.yaml pour créer la base PostgreSQL
POSTGRES_USER=zevent
POSTGRES_PASSWORD=zevent-dev
POSTGRES_DB=zevent_memory

# Lue par le backend (doit correspondre aux trois valeurs ci-dessus).
# 127.0.0.1 et pas localhost : sous Windows, localhost tente d'abord l'IPv6 (::1),
# où la base n'écoute pas, et la connexion met alors plus de 2 minutes.
DATABASE_URL=postgresql+asyncpg://zevent:zevent-dev@127.0.0.1:5432/zevent_memory
